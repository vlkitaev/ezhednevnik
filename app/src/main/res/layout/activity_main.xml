<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:paddingLeft="14dp"
    android:paddingRight="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp">

        <Button
            android:id="@+id/btnPrev"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:textSize="17sp"
            android:textColor="@color/muted"
            android:text="◀" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:text="—" />

            <TextView
                android:id="@+id/tvDow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:text="" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:textSize="17sp"
            android:textColor="@color/muted"
            android:text="▶" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">

        <ProgressBar
            android:id="@+id/pb"
            style="@android:style/Widget.Material.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/track" />

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="10dp"
            android:paddingRight="4dp"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:text="" />

        <TextView
            android:id="@+id/btnToday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textColor="@color/accent"
            android:visibility="gone"
            android:text="Сегодня" />
    </LinearLayout>


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbarStyle="outsideOverlay" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="@color/muted"
            android:visibility="gone"
            android:text="Пусто\nДобавьте первую запись" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/input_bg"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textSize="15sp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="Новая запись"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4" />

        <ImageButton
            android:id="@+id/btnVoice"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginLeft="8dp"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:background="@drawable/circle_soft"
            android:contentDescription="Голосовой ввод"
            android:src="@drawable/ic_mic" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginLeft="8dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:background="@drawable/fab"
            android:textSize="24sp"
            android:textColor="#FFFFFFFF"
            android:text="+" />
    </LinearLayout>

</LinearLayout>
